<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@color/dex_surface_dark"
    android:padding="20dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/change_wallpaper"
        android:textColor="@color/dex_text_primary"
        android:textSize="18sp"
        android:textStyle="bold"
        android:layout_marginBottom="16dp" />

    <!-- Preset Grid (2 rows x 3 columns) -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Desktop Presets"
        android:textColor="@color/dex_text_secondary"
        android:textSize="12sp"
        android:layout_marginBottom="8dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:orientation="horizontal"
        android:weightSum="3"
        android:layout_marginBottom="8dp">

        <FrameLayout
            android:id="@+id/presetWallpaper0"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginEnd="6dp"
            android:background="@drawable/wallpaper_windows_bloom"
            android:clickable="true"
            android:focusable="true" />

        <FrameLayout
            android:id="@+id/presetWallpaper1"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginEnd="6dp"
            android:background="@drawable/wallpaper_aurora_borealis"
            android:clickable="true"
            android:focusable="true" />

        <FrameLayout
            android:id="@+id/presetWallpaper2"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/wallpaper_cyberpunk"
            android:clickable="true"
            android:focusable="true" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:orientation="horizontal"
        android:weightSum="3"
        android:layout_marginBottom="16dp">

        <FrameLayout
            android:id="@+id/presetWallpaper3"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginEnd="6dp"
            android:background="@drawable/wallpaper_dex_dark"
            android:clickable="true"
            android:focusable="true" />

        <FrameLayout
            android:id="@+id/presetWallpaper4"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginEnd="6dp"
            android:background="@drawable/wallpaper_emerald"
            android:clickable="true"
            android:focusable="true" />

        <FrameLayout
            android:id="@+id/presetWallpaper5"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/wallpaper_sapphire"
            android:clickable="true"
            android:focusable="true" />
    </LinearLayout>

    <!-- Custom Image Button -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnPickCustomWallpaper"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:text="@string/choose_from_gallery"
        android:textColor="@color/dex_text_primary"
        app:icon="@drawable/ic_wallpaper"
        app:iconTint="@color/dex_accent_cyan"
        app:backgroundTint="#26FFFFFF"
        app:cornerRadius="8dp" />

</LinearLayout>
