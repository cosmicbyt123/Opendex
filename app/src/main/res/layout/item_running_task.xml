<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="48dp"
    android:layout_height="52dp"
    android:orientation="vertical"
    android:gravity="center"
    android:layout_marginStart="3dp"
    android:layout_marginEnd="3dp"
    android:background="@drawable/bg_taskbar_btn"
    android:clickable="true"
    android:focusable="true">

    <!-- Unified Squircle Tile Frame for Every App Icon -->
    <FrameLayout
        android:layout_width="38dp"
        android:layout_height="38dp"
        android:layout_gravity="center_horizontal"
        android:background="@drawable/bg_dock_squircle"
        android:padding="3dp">

        <ImageView
            android:id="@+id/runningTaskIcon"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="fitCenter"
            android:contentDescription="App Icon" />
    </FrameLayout>

    <!-- macOS / DeX Active Window Indicator Dot -->
    <View
        android:id="@+id/runningTaskIndicator"
        android:layout_width="5dp"
        android:layout_height="5dp"
        android:layout_marginTop="2dp"
        android:background="@drawable/bg_dock_dot" />

    <!-- Kept for backward compatibility with adapter code -->
    <TextView
        android:id="@+id/runningTaskLabel"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone" />

    <ImageView
        android:id="@+id/runningTaskCloseBtn"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone" />

</LinearLayout>
