<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/desktopRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/dex_bg_dark">

    <!-- Ambient Desktop Background Gradient / Wallpaper -->
    <ImageView
        android:id="@+id/desktopWallpaper"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:src="@drawable/wallpaper_hyper_space"
        android:contentDescription="Wallpaper" />

    <!-- Clean Empty Desktop Canvas (Preserved for compatibility) -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/desktopIconGrid"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- Living Desktop Clock & Glance Widget -->
    <LinearLayout
        android:id="@+id/desktopClockWidget"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginStart="52dp"
        android:layout_marginTop="52dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <TextClock
            android:id="@+id/widgetClockTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:format12Hour="h:mm"
            android:format24Hour="HH:mm"
            android:textColor="#FFFFFF"
            android:textSize="64sp"
            android:fontFamily="sans-serif-light"
            android:letterSpacing="-0.02" />

        <TextClock
            android:id="@+id/widgetClockDate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:format12Hour="EEEE, MMMM d"
            android:format24Hour="EEEE, MMMM d"
            android:textColor="#94A3B8"
            android:textSize="16sp"
            android:fontFamily="sans-serif-medium"
            android:layout_marginTop="-4dp" />
    </LinearLayout>

    <!-- Centered DeX App Drawer & Spotlight Search Overlay Scrim -->
    <FrameLayout
        android:id="@+id/startMenuScrim"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#66000000"
        android:visibility="gone"
        android:elevation="36dp">

        <androidx.cardview.widget.CardView
            android:id="@+id/startMenuCard"
            android:layout_width="660dp"
            android:layout_height="500dp"
            android:layout_gravity="center"
            app:cardCornerRadius="24dp"
            app:cardElevation="36dp"
            app:cardBackgroundColor="#F20B1120">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:padding="20dp">

                <!-- Search Pill -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:background="@drawable/bg_search_input"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:layout_marginBottom="14dp">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@android:drawable/ic_menu_search"
                        app:tint="@color/dex_accent_cyan"
                        android:contentDescription="Search" />

                    <EditText
                        android:id="@+id/searchAppsInput"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@null"
                        android:hint="Search apps, settings, tools..."
                        android:textColorHint="@color/dex_text_secondary"
                        android:textColor="@color/dex_text_primary"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:textSize="15sp"
                        android:singleLine="true"
                        android:imeOptions="actionSearch" />
                </LinearLayout>

                <!-- 5-Column Grid -->
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/startMenuAppGrid"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:clipToPadding="false" />

                <!-- Footer -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="36dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingTop="4dp">

                    <TextView
                        android:id="@+id/allAppsCountText"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Installed Apps"
                        android:textColor="@color/dex_text_secondary"
                        android:textSize="12sp" />

                    <ImageView
                        android:id="@+id/desktopSettingsBtn"
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:padding="4dp"
                        android:src="@android:drawable/ic_menu_preferences"
                        android:contentDescription="Settings"
                        app:tint="@color/dex_text_secondary" />
                </LinearLayout>
            </LinearLayout>
        </androidx.cardview.widget.CardView>
    </FrameLayout>

    <!-- Tablet Quick Settings Control Center (Pops up from Bottom-Right above Tray) -->
    <androidx.cardview.widget.CardView
        android:id="@+id/controlCenterCard"
        android:layout_width="340dp"
        android:layout_height="wrap_content"
        android:layout_marginEnd="12dp"
        android:layout_marginBottom="8dp"
        android:visibility="gone"
        app:cardCornerRadius="18dp"
        app:cardElevation="28dp"
        app:cardBackgroundColor="#F20D1322"
        app:layout_constraintBottom_toTopOf="@id/taskbar"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Control Center Header -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="14dp">

                <TextView
                    android:id="@+id/ccDateText"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Wednesday, Nov 18"
                    android:textColor="@color/dex_text_primary"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <ImageView
                    android:id="@+id/ccSettingsBtn"
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:padding="3dp"
                    android:src="@android:drawable/ic_menu_preferences"
                    android:contentDescription="Settings"
                    app:tint="@color/dex_text_secondary"
                    android:clickable="true"
                    android:focusable="true" />
            </LinearLayout>

            <!-- 2x2 Quick Toggle Grid -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="8dp">

                <!-- Wi-Fi Toggle -->
                <LinearLayout
                    android:id="@+id/pillWifi"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="4dp"
                    android:background="@drawable/bg_control_pill"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:clickable="true"
                    android:focusable="true">

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:src="@drawable/ic_wifi"
                        app:tint="@color/dex_accent_cyan"
                        android:contentDescription="Wi-Fi" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:text="Wi-Fi"
                        android:textColor="@color/dex_text_primary"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- Bluetooth Toggle -->
                <LinearLayout
                    android:id="@+id/pillBluetooth"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:layout_marginStart="4dp"
                    android:background="@drawable/bg_control_pill"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:clickable="true"
                    android:focusable="true">

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:src="@drawable/ic_bluetooth"
                        app:tint="@color/dex_accent_cyan"
                        android:contentDescription="Bluetooth" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:text="Bluetooth"
                        android:textColor="@color/dex_text_primary"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="14dp">

                <!-- Auto-Rotate -->
                <LinearLayout
                    android:id="@+id/pillRotation"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="4dp"
                    android:background="@drawable/bg_control_pill"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:clickable="true"
                    android:focusable="true">

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:src="@drawable/ic_rotation"
                        app:tint="@color/dex_accent_cyan"
                        android:contentDescription="Rotation" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:text="Rotation"
                        android:textColor="@color/dex_text_primary"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- Displays -->
                <LinearLayout
                    android:id="@+id/pillDisplay"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:layout_marginStart="4dp"
                    android:background="@drawable/bg_control_pill"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:clickable="true"
                    android:focusable="true">

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:src="@drawable/ic_display_connected"
                        app:tint="@color/dex_accent_cyan"
                        android:contentDescription="Displays" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:text="Displays"
                        android:textColor="@color/dex_text_primary"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>

            <!-- Brightness Slider -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:layout_marginBottom="12dp">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_brightness"
                    app:tint="@color/dex_accent_cyan"
                    android:contentDescription="Brightness" />

                <SeekBar
                    android:id="@+id/brightnessSeekBar"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:max="100"
                    android:progress="85"
                    android:progressTint="@color/dex_accent_cyan"
                    android:thumbTint="@color/dex_accent_cyan" />
            </LinearLayout>

            <!-- Media Volume Slider -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:layout_marginBottom="14dp">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_volume"
                    app:tint="@color/dex_accent_cyan"
                    android:contentDescription="Volume" />

                <SeekBar
                    android:id="@+id/volumeSeekBar"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:max="15"
                    android:progress="10"
                    android:progressTint="@color/dex_accent_cyan"
                    android:thumbTint="@color/dex_accent_cyan" />
            </LinearLayout>

            <!-- Control Center Footer -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="32dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingTop="2dp">

                <TextView
                    android:id="@+id/ccBatteryPercent"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Battery: 100%"
                    android:textColor="@color/dex_text_secondary"
                    android:textSize="12sp" />

                <ImageView
                    android:id="@+id/ccPowerBtn"
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:padding="3dp"
                    android:src="@drawable/ic_power"
                    android:contentDescription="Power"
                    android:clickable="true"
                    android:focusable="true" />
            </LinearLayout>
        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <!-- Workspaces / Virtual Desktops Bar (Pops up from Bottom-Left above Taskbar) -->
    <androidx.cardview.widget.CardView
        android:id="@+id/taskViewCard"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginBottom="8dp"
        android:visibility="gone"
        app:cardCornerRadius="20dp"
        app:cardElevation="28dp"
        app:cardBackgroundColor="#F20D1322"
        app:layout_constraintBottom_toTopOf="@id/taskbar"
        app:layout_constraintStart_toStartOf="parent">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="14dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Workspaces (Virtual Desktops)"
                android:textColor="@color/dex_text_primary"
                android:textSize="12sp"
                android:textStyle="bold"
                android:layout_marginBottom="10dp" />

            <!-- Desktops Row -->
            <LinearLayout
                android:id="@+id/virtualDesktopsRow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical" />

            <!-- Active Windows Overview (Task View / Show Windows) -->
            <TextView
                android:id="@+id/taskViewWindowsTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Active Windows"
                android:textColor="@color/dex_text_primary"
                android:textSize="12sp"
                android:textStyle="bold"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="8dp" />

            <LinearLayout
                android:id="@+id/taskViewWindowsRow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical" />
        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <!-- Centered Workspace Switch HUD Indicator -->
    <androidx.cardview.widget.CardView
        android:id="@+id/workspaceHUD"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="gone"
        app:cardCornerRadius="20dp"
        app:cardElevation="32dp"
        app:cardBackgroundColor="#CC0F172A"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:paddingTop="12dp"
            android:paddingBottom="12dp">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_task_view"
                app:tint="@color/dex_accent_cyan"
                android:contentDescription="Workspace" />

            <TextView
                android:id="@+id/workspaceHUDText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:text="Desktop 1"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold" />
        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <!-- Single Unified Desktop Taskbar -->
    <LinearLayout
        android:id="@+id/taskbar"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:elevation="16dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/bg_dex_taskbar"
        android:paddingStart="8dp"
        android:paddingEnd="12dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- App Launcher (9-Dot DeX Button) -->
        <FrameLayout
            android:id="@+id/startMenuButton"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:background="@drawable/bg_taskbar_btn"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_gravity="center"
                android:src="@android:drawable/ic_dialog_dialer"
                app:tint="@color/dex_accent_cyan"
                android:contentDescription="App Drawer" />
        </FrameLayout>

        <!-- Navigation Back Button -->
        <FrameLayout
            android:id="@+id/navBackButton"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:layout_marginStart="4dp"
            android:background="@drawable/bg_taskbar_btn"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_nav_back"
                app:tint="@color/dex_text_primary"
                android:contentDescription="Back" />
        </FrameLayout>

        <!-- Virtual Desktops Button -->
        <FrameLayout
            android:id="@+id/taskViewButton"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:layout_marginStart="4dp"
            android:background="@drawable/bg_taskbar_btn"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_task_view"
                app:tint="@color/dex_accent_cyan"
                android:contentDescription="Virtual Desktops" />
        </FrameLayout>

        <!-- Active Workspace Pill -->
        <LinearLayout
            android:id="@+id/workspaceBadgePill"
            android:layout_width="wrap_content"
            android:layout_height="24dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/bg_space_pill"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:layout_marginStart="6dp"
            android:clickable="true"
            android:focusable="true">

            <TextView
                android:id="@+id/workspaceBadgeText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="● Desktop 1"
                android:textColor="@color/dex_accent_cyan"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Subtle Taskbar Divider -->
        <View
            android:layout_width="1dp"
            android:layout_height="24dp"
            android:background="#26FFFFFF"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp" />

        <!-- Running & Pinned Tasks List (Takes middle space) -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/runningTasksList"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="horizontal" />

        <!-- Subtle Taskbar Divider -->
        <View
            android:layout_width="1dp"
            android:layout_height="24dp"
            android:background="#26FFFFFF"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp" />

        <!-- System Tray Quick Settings -->
        <LinearLayout
            android:id="@+id/systemTray"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="4dp"
            android:paddingEnd="4dp"
            android:clickable="true"
            android:focusable="true">

            <!-- Wi-Fi Status Icon -->
            <ImageView
                android:id="@+id/trayWifiIcon"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_marginEnd="10dp"
                android:src="@drawable/ic_wifi"
                app:tint="@color/dex_accent_cyan"
                android:contentDescription="Wi-Fi Status"
                android:clickable="true"
                android:focusable="true" />

            <!-- Volume / Audio Icon -->
            <ImageView
                android:id="@+id/trayVolumeIcon"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_marginEnd="10dp"
                android:src="@drawable/ic_volume"
                app:tint="@color/dex_accent_cyan"
                android:contentDescription="Volume Status"
                android:clickable="true"
                android:focusable="true" />

            <!-- Virtual Keyboard Toggle Button -->
            <ImageView
                android:id="@+id/trayKeyboardBtn"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_marginEnd="10dp"
                android:src="@drawable/ic_keyboard"
                app:tint="@color/dex_accent_cyan"
                android:contentDescription="Virtual Keyboard"
                android:clickable="true"
                android:focusable="true" />

            <!-- Notifications Center Toggle Button -->
            <ImageView
                android:id="@+id/trayNotificationBtn"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_marginEnd="10dp"
                android:src="@drawable/ic_notification"
                app:tint="@color/dex_accent_cyan"
                android:contentDescription="Notifications"
                android:clickable="true"
                android:focusable="true" />

            <!-- External Display Indicator -->
            <ImageView
                android:id="@+id/trayDisplayIcon"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_marginEnd="10dp"
                android:src="@drawable/ic_display_connected"
                android:visibility="gone"
                android:contentDescription="External Display"
                android:clickable="true"
                android:focusable="true" />

            <!-- Battery Status -->
            <TextView
                android:id="@+id/trayBatteryText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="100%"
                android:textColor="@color/dex_text_primary"
                android:textSize="12sp"
                android:textStyle="bold"
                android:layout_marginEnd="10dp" />

            <!-- Live Clock -->
            <TextClock
                android:id="@+id/trayClock"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:format12Hour="h:mm a"
                android:format24Hour="HH:mm"
                android:textColor="@color/dex_text_primary"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <!-- Software Brightness Dimmer Overlay (dims display on laptop, monitor, or phone) -->
    <View
        android:id="@+id/brightnessDimmer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#000000"
        android:alpha="0.0"
        android:clickable="false"
        android:focusable="false"
        android:elevation="100dp" />

</androidx.constraintlayout.widget.ConstraintLayout>
