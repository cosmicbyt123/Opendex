<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/desktopRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/dex_bg_dark">

    <!-- Ambient Desktop Background Gradient / Wallpaper -->
    <ImageView
        android:id="@+id/desktopWallpaper"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:contentDescription="Wallpaper" />

    <!-- Windows-Style Left Desktop Icon Column (Clean Desktop) -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/desktopIconGrid"
        android:layout_width="100dp"
        android:layout_height="0dp"
        android:paddingTop="16dp"
        android:paddingBottom="16dp"
        android:paddingStart="4dp"
        android:paddingEnd="4dp"
        android:clipToPadding="false"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/taskbar"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- Start Menu Drawer (Pop-up above Taskbar) -->
    <androidx.cardview.widget.CardView
        android:id="@+id/startMenuCard"
        android:layout_width="480dp"
        android:layout_height="520dp"
        android:layout_marginStart="16dp"
        android:layout_marginBottom="8dp"
        android:visibility="gone"
        app:cardCornerRadius="16dp"
        app:cardElevation="24dp"
        app:cardBackgroundColor="@color/dex_surface_dark"
        app:layout_constraintBottom_toTopOf="@id/taskbar"
        app:layout_constraintStart_toStartOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Search Input -->
            <EditText
                android:id="@+id/searchAppsInput"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:background="@drawable/bg_search_input"
                android:hint="@string/search_apps"
                android:textColorHint="@color/dex_text_secondary"
                android:textColor="@color/dex_text_primary"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:textSize="14sp"
                android:singleLine="true"
                android:imeOptions="actionSearch" />

            <!-- App Drawer Grid -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/startMenuAppGrid"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:layout_marginTop="12dp"
                android:clipToPadding="false" />

            <!-- Start Menu Footer -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingTop="8dp">

                <TextView
                    android:id="@+id/allAppsCountText"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Installed Apps"
                    android:textColor="@color/dex_text_secondary"
                    android:textSize="12sp" />

                <ImageView
                    android:id="@+id/desktopSettingsBtn"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:padding="4dp"
                    android:src="@android:drawable/ic_menu_preferences"
                    android:contentDescription="Settings"
                    app:tint="@color/dex_text_secondary" />
            </LinearLayout>
        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <!-- Tablet Quick Settings Control Center (Pop-up above System Tray) -->
    <androidx.cardview.widget.CardView
        android:id="@+id/controlCenterCard"
        android:layout_width="340dp"
        android:layout_height="wrap_content"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="8dp"
        android:visibility="gone"
        app:cardCornerRadius="16dp"
        app:cardElevation="24dp"
        app:cardBackgroundColor="@color/dex_surface_dark"
        app:layout_constraintBottom_toTopOf="@id/taskbar"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Control Center Header -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="14dp">

                <TextView
                    android:id="@+id/ccDateText"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Wednesday, Nov 18"
                    android:textColor="@color/dex_text_primary"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <ImageView
                    android:id="@+id/ccSettingsBtn"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:padding="4dp"
                    android:src="@android:drawable/ic_menu_preferences"
                    app:tint="@color/dex_text_secondary"
                    android:contentDescription="Settings" />
            </LinearLayout>

            <!-- Quick Toggle Pills (2x2 Grid) -->
            <GridLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:columnCount="2"
                android:rowCount="2"
                android:layout_marginBottom="16dp">

                <!-- Wi-Fi Pill -->
                <LinearLayout
                    android:id="@+id/pillWifi"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_columnWeight="1"
                    android:layout_marginEnd="6dp"
                    android:layout_marginBottom="8dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:background="@drawable/bg_control_pill"
                    android:clickable="true"
                    android:focusable="true">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ic_wifi"
                        app:tint="@color/dex_accent_cyan" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:text="Wi-Fi"
                        android:textColor="@color/dex_text_primary"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- Bluetooth Pill -->
                <LinearLayout
                    android:id="@+id/pillBluetooth"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_columnWeight="1"
                    android:layout_marginStart="6dp"
                    android:layout_marginBottom="8dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:background="@drawable/bg_control_pill"
                    android:clickable="true"
                    android:focusable="true">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ic_bluetooth"
                        app:tint="@color/dex_accent_cyan" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:text="Bluetooth"
                        android:textColor="@color/dex_text_primary"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- Rotation Pill -->
                <LinearLayout
                    android:id="@+id/pillRotation"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_columnWeight="1"
                    android:layout_marginEnd="6dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:background="@drawable/bg_control_pill"
                    android:clickable="true"
                    android:focusable="true">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ic_rotation"
                        app:tint="@color/dex_accent_cyan" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:text="Rotation"
                        android:textColor="@color/dex_text_primary"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- Display Settings Pill -->
                <LinearLayout
                    android:id="@+id/pillDisplay"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_columnWeight="1"
                    android:layout_marginStart="6dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:background="@drawable/bg_control_pill"
                    android:clickable="true"
                    android:focusable="true">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ic_display_connected"
                        app:tint="@color/dex_accent_cyan" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:text="Displays"
                        android:textColor="@color/dex_text_primary"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </GridLayout>

            <!-- Brightness Slider -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="12dp">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:src="@drawable/ic_brightness"
                    app:tint="@color/dex_accent_cyan" />

                <SeekBar
                    android:id="@+id/brightnessSeekBar"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:max="100"
                    android:progress="70"
                    android:progressTint="@color/dex_accent_cyan"
                    android:thumbTint="@color/dex_accent_cyan" />
            </LinearLayout>

            <!-- Volume Slider -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="12dp">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:src="@drawable/ic_volume"
                    app:tint="@color/dex_accent_blue" />

                <SeekBar
                    android:id="@+id/volumeSeekBar"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:max="100"
                    android:progress="50"
                    android:progressTint="@color/dex_accent_blue"
                    android:thumbTint="@color/dex_accent_blue" />
            </LinearLayout>

            <!-- Footer / Power -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="36dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingTop="4dp">

                <TextView
                    android:id="@+id/ccBatteryPercent"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Battery: 100%"
                    android:textColor="@color/dex_text_secondary"
                    android:textSize="12sp" />

                <ImageView
                    android:id="@+id/ccPowerBtn"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:padding="4dp"
                    android:src="@drawable/ic_power"
                    android:contentDescription="Power"
                    android:clickable="true"
                    android:focusable="true" />
            </LinearLayout>
        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <!-- Virtual Desktops Card (Task View pop-up above Taskbar) -->
    <androidx.cardview.widget.CardView
        android:id="@+id/taskViewCard"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="64dp"
        android:layout_marginBottom="8dp"
        android:visibility="gone"
        app:cardCornerRadius="16dp"
        app:cardElevation="24dp"
        app:cardBackgroundColor="@color/dex_surface_dark"
        app:layout_constraintBottom_toTopOf="@id/taskbar"
        app:layout_constraintStart_toStartOf="parent">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Virtual Desktops (Workspaces)"
                android:textColor="@color/dex_text_primary"
                android:textSize="14sp"
                android:textStyle="bold"
                android:layout_marginBottom="12dp" />

            <!-- Desktops Row -->
            <LinearLayout
                android:id="@+id/virtualDesktopsRow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical" />
        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <!-- Bottom Taskbar -->
    <LinearLayout
        android:id="@+id/taskbar"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:elevation="16dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@color/dex_taskbar_bg"
        android:paddingStart="12dp"
        android:paddingEnd="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Start Menu Button -->
        <FrameLayout
            android:id="@+id/startMenuButton"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_taskbar_btn"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="center"
                android:src="@android:drawable/ic_dialog_dialer"
                app:tint="@color/dex_accent_cyan"
                android:contentDescription="Start Menu" />
        </FrameLayout>

        <!-- Navigation Back Button -->
        <FrameLayout
            android:id="@+id/navBackButton"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="4dp"
            android:background="@drawable/bg_taskbar_btn"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_nav_back"
                app:tint="@color/dex_text_primary"
                android:contentDescription="Back" />
        </FrameLayout>

        <!-- Task View / Virtual Desktops Button -->
        <FrameLayout
            android:id="@+id/taskViewButton"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="4dp"
            android:background="@drawable/bg_taskbar_btn"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_task_view"
                app:tint="@color/dex_accent_cyan"
                android:contentDescription="Virtual Desktops" />
        </FrameLayout>

        <!-- Running Task Bar -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/runningTasksList"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"
            android:orientation="horizontal" />

        <!-- System Tray -->
        <LinearLayout
            android:id="@+id/systemTray"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="8dp"
            android:paddingEnd="8dp">

            <!-- External Display Indicator -->
            <ImageView
                android:id="@+id/trayDisplayIcon"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_marginEnd="12dp"
                android:src="@drawable/ic_display_connected"
                android:visibility="gone"
                android:contentDescription="External Display"
                android:clickable="true"
                android:focusable="true" />

            <!-- Battery Status -->
            <TextView
                android:id="@+id/trayBatteryText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="100%"
                android:textColor="@color/dex_text_primary"
                android:textSize="12sp"
                android:textStyle="bold"
                android:layout_marginEnd="12dp" />

            <!-- Live Clock -->
            <TextClock
                android:id="@+id/trayClock"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:format12Hour="h:mm a"
                android:format24Hour="HH:mm"
                android:textColor="@color/dex_text_primary"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
